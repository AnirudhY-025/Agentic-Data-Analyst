# ========================================================
# InsightFlow AI — Environment Configuration
# ========================================================

# Default LLM Model (e.g. ollama/qwen2.5:3b or openrouter/openrouter/free)
LLM_MODEL=ollama/qwen2.5:3b

# Ollama local endpoint (use host.docker.internal if running in Docker)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter API Key (optional: user can also configure this directly in the UI Settings)
OPENROUTER_API_KEY=

# LLM Creativity Temperature (0.0 to 1.0, lower is more deterministic)
LLM_TEMPERATURE=0.2

# Default base filename for generated reports
DEFAULT_OUTPUT_FILENAME=analysis_report

# ========================================================
# Frontend Firebase Authentication (.env in frontend/)
# ========================================================
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=your-app-id
